+                    name: None,
+                    off: false,
+                    calibration_matrix: None,
+                    map_to_output: Some(
+                        "eDP-1",
+                    ),
+                },
+                Touch {
+                    name: Some(
+                        "ELAN9009:00 04F3:2F2A",
+                    ),
+                    off: false,
+                    calibration_matrix: None,
+                    map_to_output: Some(
+                        "DP-1",
+                    ),
+                },
+            ],
+        )
+        "#);
+    }
