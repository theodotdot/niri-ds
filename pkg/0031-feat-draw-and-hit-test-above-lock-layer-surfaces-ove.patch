+    /// Renders the layer surfaces marked with the `above-lock` rule over the session lock screen.
+    ///
+    /// Elements are pushed top-first, like everywhere else in render(), so the overlay layer ends
+    /// up above the lock surface. Popups are not drawn: an above-lock client that needs them has
+    /// to draw its own.
+    fn render_layers_above_lock<R: NiriRenderer>(
+        &self,
+        mut ctx: RenderCtx<R>,
+        layer_map: &LayerMap,
+        push: &mut dyn FnMut(LayerSurfaceRenderElement<R>),
+    ) {
+        for layer in [Layer::Overlay, Layer::Top, Layer::Bottom, Layer::Background] {
+            for (mapped, geo) in self.layers_in_render_order(layer_map, layer, false) {
+                if !mapped.above_lock() {
+                    continue;
+                }
+
+                let loc = geo.loc.to_f64();
+                mapped.render_normal(ctx.r(), None, loc, XrayPos::default(), push);
+            }
+        }
+    }
