+    /// Returns the above-lock layer surface under the point, if any.
+    ///
+    /// Above-lock surfaces are the ones that render over the session lock screen, so they have
+    /// to take input there too. The ordering must match [`Self::render_layers_above_lock`].
+    fn above_lock_layer_under(
+        &self,
+        output: &Output,
+        pos_within_output: Point<f64, Logical>,
+    ) -> Option<(WlSurface, Point<f64, Logical>, LayerSurface)> {
+        let layers = layer_map_for_output(output);
+
+        for layer in [Layer::Overlay, Layer::Top, Layer::Bottom, Layer::Background] {
+            for layer_surface in layers.layers_on(layer).rev() {
+                let Some(mapped) = self.mapped_layer_surfaces.get(layer_surface) else {
+                    continue;
+                };
+
+                // Matches the render filter: above-lock surfaces never sit in the backdrop.
+                if !mapped.above_lock() || mapped.place_within_backdrop() {
+                    continue;
+                }
+
+                let Some(geo) = layers.layer_geometry(layer_surface) else {
+                    continue;
+                };
+
+                let layer_loc = geo.loc.to_f64() + mapped.bob_offset();
+                let surface_type = WindowSurfaceType::TOPLEVEL | WindowSurfaceType::SUBSURFACE;
+                let Some((surface, loc)) =
+                    layer_surface.surface_under(pos_within_output - layer_loc, surface_type)
+                else {
+                    continue;
+                };
+
+                return Some((surface, loc.to_f64() + layer_loc, layer_surface.clone()));
+            }
+        }
+
+        None
+    }
